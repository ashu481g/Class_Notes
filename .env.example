# Copy to .env.local (for your laptop) or add in Vercel → Project → Settings → Environment Variables.
# Both are optional: without them, the app still lets you paste a key in the browser,
# use free in-browser Whisper for transcripts, and copy the notes prompt into claude.ai.

# Used to write class notes (Claude). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: faster cloud transcription with OpenAI Whisper. https://platform.openai.com
OPENAI_API_KEY=
